PYTHONPATH=.
FLASK_APP=backend.app:create_app
THERMOGUARD_DB=data/thermoguard.db

# ── Telegram Alerts (optional) ──────────────────────────────────────────────
# Get token from @BotFather, chat_id from @userinfobot
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=123456789

# ── API Key Protection (optional) ───────────────────────────────────────────
# If set, POST /api/readings requires header: X-API-Key: <value>
# Leave unset during local dev; set in Render env vars for production.
# THERMOGUARD_API_KEY=your-secret-key-here

# ── Auto-Start Simulation on Boot (optional) ────────────────────────────────
# Set to true on Render so the cloud dashboard always has live data
# AUTO_START_SIMULATION=true
# AUTO_SIM_SCENARIO=normal
# AUTO_SIM_INTERVAL=3.0
