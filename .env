PYTHONPATH=.
FLASK_APP=backend.app:create_app
THERMOGUARD_DB=data/thermoguard.db

# ── Email Alerts via Resend (optional) ──────────────────────────────────────
# Render blocks SMTP port 587, so we use Resend's HTTPS API (always open).
# Free tier: 3,000 emails/month — sign up at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# ALERT_EMAIL_TO=you@gmail.com
# ALERT_EMAIL_FROM=ThermoGuard AI <onboarding@resend.dev>  (default, no setup needed)

# ── API Key Protection (optional) ───────────────────────────────────────────
# If set, POST /api/readings requires header: X-API-Key: <value>
# Leave unset during local dev; set in Render env vars for production.
# THERMOGUARD_API_KEY=your-secret-key-here
