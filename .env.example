# ThermoGuard AI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Database ---
# THERMOGUARD_DB=data/thermoguard.db

# --- Safety Thresholds (°C and %) ---
# TEMP_WARNING=38.0
# TEMP_CRITICAL=52.0
# HUM_WARNING=70.0
# HUM_CRITICAL=85.0

# --- Server ---
# PORT=5000
# FLASK_DEBUG=false

# --- Cloud Deployment ---
# Set these when deploying to Render, Railway, or Fly.io
# SECRET_KEY=your-secret-key-here
